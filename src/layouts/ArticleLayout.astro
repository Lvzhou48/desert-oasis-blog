---
import type { MarkdownHeading } from 'astro';
import type { Post } from '../lib/posts';
import Comments from '../components/Comments.astro';
import BaseLayout from './BaseLayout.astro';
import { estimateReadingMinutes, formatPublishedDate } from '../lib/format';
import { withBase } from '../lib/urls';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  adjacent: {
    previous?: Post;
    next?: Post;
  };
}

const { post, headings, adjacent } = Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const readingMinutes = estimateReadingMinutes(post.body ?? '');
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover?.src}>
  <article class="article-page">
    <header class="article-header">
      <a class="article-category" href={withBase(`/categories/${post.data.category}/`)}>{post.data.category}</a>
      <h1>{post.data.title}</h1>
      <p class="article-summary">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatPublishedDate(post.data.publishedAt)}</time>
        {post.data.updatedAt && (
          <span>
            更新于 <time datetime={post.data.updatedAt.toISOString()}>{formatPublishedDate(post.data.updatedAt)}</time>
          </span>
        )}
        <span>{readingMinutes} 分钟阅读</span>
      </div>
      {post.data.tags.length > 0 && (
        <ul class="article-tags" aria-label="文章标签">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    {tableOfContents.length > 0 && (
      <nav class="article-toc" aria-label="文章目录">
        <h2>本文目录</h2>
        <ol>
          {tableOfContents.map((heading) => (
            <li class:list={{ 'article-toc__nested': heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="article-body prose">
      <slot />
    </div>

    <nav class="adjacent-posts" aria-label="相邻文章">
      <div>
        {adjacent.previous && (
          <a href={withBase(`/posts/${adjacent.previous.id}/`)}>
            <span>上一篇</span>
            {adjacent.previous.data.title}
          </a>
        )}
      </div>
      <div class="adjacent-posts__next">
        {adjacent.next && (
          <a href={withBase(`/posts/${adjacent.next.id}/`)}>
            <span>下一篇</span>
            {adjacent.next.data.title}
          </a>
        )}
      </div>
    </nav>
  </article>

  <Comments />
</BaseLayout>

<style>
  .article-page {
    max-width: none;
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .article-header,
  .article-body,
  .article-toc {
    max-width: 70ch;
    margin-inline: auto;
  }

  .article-category {
    color: var(--forest);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .article-header h1 {
    max-width: 18ch;
    margin-block: 1rem 1.25rem;
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .article-summary {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    margin-block-start: 1.5rem;
    gap: 0.45rem 1.1rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    margin: 1.2rem 0 0;
    padding: 0;
    gap: 0.5rem;
    list-style: none;
  }

  .article-tags li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--forest-deep);
    font-size: 0.8rem;
  }

  .article-toc {
    margin-block: clamp(2.5rem, 7vw, 4.5rem);
    padding: 1.25rem 1.5rem;
    border-inline-start: 3px solid var(--earth-gold);
    background: rgb(234 219 189 / 28%);
  }

  .article-toc h2 {
    margin: 0 0 0.65rem;
    font-size: 1.1rem;
  }

  .article-toc ol {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  .article-toc__nested {
    margin-inline-start: 1rem;
  }

  .article-body {
    margin-block-start: clamp(2.5rem, 7vw, 4.5rem);
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    scroll-margin-top: 2rem;
    margin-block: 2.5rem 0.8rem;
  }

  .article-body :global(p) {
    margin-block: 0 1.35rem;
  }

  .adjacent-posts {
    display: grid;
    max-width: 70ch;
    margin: clamp(3rem, 8vw, 6rem) auto 0;
    padding-block-start: 2rem;
    border-top: 1px solid var(--border);
    gap: 1rem;
  }

  .adjacent-posts a {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .adjacent-posts span {
    display: block;
    margin-block-end: 0.25rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .adjacent-posts__next {
    text-align: end;
  }

  @media (min-width: 40rem) {
    .adjacent-posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
