---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = siteConfig.description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const socialImage = image ? new URL(image, canonical) : undefined;
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f0e4" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳到正文</a>
    <SiteHeader />
    <main id="main-content" class="site-shell">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
